# Copy this to terraform.tfvars and fill in your own values —
# terraform.tfvars is gitignored, so your real settings never get committed.
#
# No secrets belong in this file either way — generated values (RDS
# password, AUTH_SECRET) are created by Terraform itself and pushed to
# SSM Parameter Store, never written to a file.

region       = "us-east-1"
project_name = "landing-builder"
environment  = "demo"

# Confirm your account isn't Free-Tier-restricted to t3.micro/t3.small
# before applying with a larger type — a brand-new AWS account can reject
# t3.medium+ with "InvalidParameterCombination - not eligible for Free
# Tier" until that restriction is lifted.
node_instance_type = "t3.medium"
node_capacity_type = "ON_DEMAND" # switch to "SPOT" to cut compute cost further
node_min_size      = 1
node_max_size      = 2
node_desired_size  = 2

db_instance_class = "db.t3.micro"

# A PUBLIC Route53 hosted zone for this domain must already exist, with
# your registrar's NS records pointing at it — verify with `dig NS
# <your-domain>` before enabling. Terraform looks the zone up (it does not
# create one) and issues an ACM certificate (apex + wildcard) validated
# through it. Leave enable_dns = false to skip this entirely.
enable_dns  = true
domain_name = "example.com"

# S3 bucket names are globally unique across ALL AWS accounts — pick
# something that won't collide, e.g. suffix with your account id or a
# random string, before the first `terraform apply`. THIS ONE IS REQUIRED
# even with DNS off.
published_pages_bucket_name = "CHANGE-ME-published-pages-landing-builder"
